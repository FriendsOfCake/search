{
    "name": "friendsofcake/search",
    "description": "CakePHP Search plugin using PRG pattern",
    "license": "MIT",
    "type": "cakephp-plugin",
    "keywords": [
        "cakephp",
        "prg",
        "filter",
        "search"
    ],
    "authors": [
        {
            "name": "Christian Winther",
            "role": "Author"
        },
        {
            "name": "ADmad",
            "homepage": "https://github.com/admad",
            "role": "Contributor"
        }
    ],
    "homepage": "https://github.com/FriendsOfCake/search",
    "support": {
        "issues": "https://github.com/FriendsOfCake/search/issues",
        "source": "https://github.com/FriendsOfCake/search"
    },
    "require": {
        "php": ">=8.5",
        "cakephp/cakephp": "^6.0@dev"
    },
    "require-dev": {
        "cakephp/bake": "^4.0@dev",
        "cakephp/cakephp-codesniffer": "6.x-dev",
        "cakephp/twig-view": "^3.0@dev",
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Search\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cake\\Test\\Fixture\\": "vendor/cakephp/cakephp/tests/Fixture/",
            "Search\\Test\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "cs-check": "phpcs -p",
        "cs-fix": "phpcbf -p",
        "stan": "tools/phpstan analyse",
        "stan-baseline": "tools/phpstan --generate-baseline",
        "stan-setup": "phive install",
        "stan-tests": "tools/phpstan analyze -c tests/phpstan.neon",
        "test": "phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
